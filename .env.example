# Copy this file to .env and fill in your keys. Never commit .env (it is in .gitignore).
# With keys set the dashboard uses the REAL APIs by default (sidebar "Offline / demo mode" off):
#   NASA FIRMS satellite fire detections, OpenWeatherMap current weather, Google satellite maps.
# Without keys it runs in offline/demo mode with synthetic data, labelled DEMO everywhere.

# NASA FIRMS MAP_KEY: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# OpenWeatherMap API key: https://home.openweathermap.org/api_keys (new keys can take a few hours to activate)
OWM_API_KEY=

# --- Email notifications (optional - new EXTREME-zone alerts) ---
# Works with Gmail (use an App Password, not your normal password), Outlook,
# or any SMTP server. Leave blank to run without email alerts - the system
# still detects and logs new extreme zones in the database either way.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
ALERT_RECIPIENT_EMAILS=recipient1@example.com,recipient2@example.com

# --- Default admin account (auth) ---
# Only used to create the FIRST account, when the users table is empty.
# Sign in and change the password from the Admin page after first run.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=changeme123

# --- Google Maps (Spread Simulation satellite base map) ---
# Google Cloud Console -> enable "Maps JavaScript API" (billing must be on) ->
# create an API key. GOOGLE_MAPS_MAP_ID is optional: a vector Map ID enables
# 3D tilt / rotation; without it Google's DEMO_MAP_ID is used.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=
