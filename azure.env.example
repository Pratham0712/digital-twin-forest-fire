# Copy this file to  azure.env  (same folder as deploy_azure.ps1) and fill in your values.
# Plain KEY=VALUE lines. Quotes are optional and are removed. Lines starting with # are ignored.
# NEVER commit azure.env to git (add it to .gitignore).

# --- Live data (leave empty to run in demo mode) ---
FIRMS_MAP_KEY=
OWM_API_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=

# --- First admin account (created when the users table is empty) ---
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me-to-a-strong-password

# --- Alerts: mock = record attempts, send nothing ---
ALERT_PROVIDER_MODE=mock

# --- Email (Gmail needs an App Password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Several recipients: one line, comma-separated, no extra quotes
ALERT_RECIPIENT_EMAILS=

# --- Database (TiDB / Aiven MySQL) ---
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# --- Leave APP_URL empty: the script fills in your https://<app>.azurewebsites.net address ---
APP_URL=
